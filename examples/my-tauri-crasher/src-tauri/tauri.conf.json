{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-tauri-crasher",
  "identifier": "com.bugsplat.my-tauri-crasher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "my-tauri-crasher",
        "width": 900,
        "height": 1000,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Helpers/BugSplatMonitor": "bugsplat-helpers/BugSplatMonitor",
        "Helpers/BugSplatReporter.app": "bugsplat-helpers/BugSplatReporter.app"
      }
    }
  }
}
