<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX fragment (tauri.windows.conf.json: bundle.windows.wix.fragmentPaths and componentRefs).

  Windows Error Reporting only calls BugSplatWer.dll if its full path is a value under
  RuntimeExceptionHelperModules; without it, fail-fast crashes (__fastfail, /GS buffer overruns)
  produce no report. Tauri's MSI installs per machine (Program Files, elevated), so the value goes
  under HKLM. Windows Installer removes it on uninstall.
-->
<?if $(sys.BUILDARCH)="x86"?>
  <?define BugSplatWin64 = "no" ?>
<?else?>
  <?define BugSplatWin64 = "yes" ?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="BugSplatWerAllowList" Guid="4EB84D16-FBF9-4DE3-BEF2-5E54A2F152E1" Win64="$(var.BugSplatWin64)">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\RuntimeExceptionHelperModules"
                       Name="[INSTALLDIR]BugSplatWer.dll" Type="integer" Value="0" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
